SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_KEY
TOKEN_API_BASE=
# Google OAuth — the WEB client ID is the serverClientId Supabase validates;
# the iOS client ID backs the native sheet + the Info.plist URL scheme.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# ─── Transcript repair for weak-STT languages (POST /translation/fix) ───────
# Cheap model first; the big one only when it declines (UNCLEAR).
# Without FIX_KEY the route falls back to the escalation model alone.
FIX_KEY=
# Test only: set to 1 to have the WEB clip route log whether Whisper's
# transcript needed a real word repaired ([repair-probe] lines). Needs FIX_KEY.
# Adds one cheap call per segment; changes nothing the peer hears. Leave unset.
CLIP_REPAIR_PROBE=
FIX_BASE=https://api.deepseek.com
FIX_MODEL=deepseek-v4-flash
# Escalation runs on OPENAI_API_KEY. Set FIX_ESCALATE=0 to disable it.
FIX_ESCALATE_MODEL=gpt-4.1
FIX_ESCALATE=1
