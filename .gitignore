# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Secrets
.env
backend/.env
backend/node_modules/
/node_modules/
/coverage/
# Firebase admin SDK service-account JSONs — Railway env var only,
# NEVER committed. Any leak gives full admin access to the project.
*-firebase-adminsdk-*.json
**/firebase-adminsdk-*.json

# Apple signing keys: APNs auth keys (AuthKey_*.p8) and App Store
# Connect API keys (SubscriptionKey_*.p8). Server-side secrets — the
# APNs key is uploaded to the Firebase console, never to the repo.
*.p8
**/*.p8

# Google OAuth client downloads. The *_secret_*.json holds the Web client
# secret (pasted into Supabase only); the client_*.plist is the iOS client
# config. Neither is needed by the app — IDs are passed via --dart-define.
client_secret_*.json
client_*.apps.googleusercontent.com.plist

# Android release signing — the keystore + its password file must
# never be committed. Losing them means losing the ability to update
# the app on Play Store, leaking them means anyone can ship malware
# under your name.
android/key.properties
android/*.jks
**/key.properties
**/*.jks

# Local emulator runner — may carry the publishable Supabase key
# pre-filled. Publishable keys are technically safe to share, but
# keeping this file local avoids re-committing it every time someone
# tweaks the run config.
run-emulator.ps1

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Claude Code local config (per-machine settings, not app code)
.claude/

# Stray screenshots (French Windows default name)
Capture d'écran*.png
capture-*.png

# Swayco design handoff reference (Next.js project, not part of the Flutter app)
xxxx/

# libvosk binaries — fetched by scripts/fetch_libvosk_android.sh (16 MB)
android/app/src/main/jniLibs/

# libvosk for iOS — built by scripts/build_libvosk_ios.sh (large static lib)
build/libvosk-ios/
ios/Frameworks/libvosk.a

# llama.cpp / ggml static libs for iOS on-device translation — built by
# scripts/build_llama_ios.sh from the STQ_0 fork (~8 MB). The podspec force_loads them.
native/llm_llamacpp_patched/ios/libs/

# STQ-fork llama.cpp / ggml shared libs for Android on-device translation —
# (re)built by scripts/build_llama_android.sh (~52 MB). Packaged as jniLibs.
native/llm_llamacpp_patched/android/src/main/jniLibs/

# Gradle artefacts of the vendored llm_llamacpp android module
native/llm_llamacpp_patched/android/.gradle/
native/llm_llamacpp_patched/android/build/
