# Swayco Admin — environment.
# Copy this file to `.env.local` (which is git-ignored) and fill it in.

# ── Supabase ──────────────────────────────────────────────────────────
# Same Supabase project as the Swayco app + backend.
#  * URL + anon key are public (used only for the admin sign-in).
#  * The service-role key BYPASSES RLS — it is what reads the locked
#    `analytics_events` table. Server-side only; never expose it.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cost rates (Monétisation) ─────────────────────────────────────────
# Cost = measured usage × these rates. Defaults below reflect public
# pricing as of 2026-05; always re-check the official pages before
# trusting the margin numbers.
#
#   OpenAI Realtime (gpt-realtime) — USD per minute of translation
#   pipeline uptime. Roughly:
#     audio in  ≈ 600 tokens / min × $32 / 1M = $0.019
#     audio out ≈ 1200 tokens / min × $64 / 1M = $0.077
#   Total ≈ $0.10 / min (assistant-heavy because our pipeline does TTS).
#   Source: https://openai.com/api/pricing
COST_REALTIME_USD_PER_MIN=0.10
#   LiveKit Cloud (Build / Ship tiers) — USD per participant-minute,
#   $0.0005 after the free tier allotment.
#   Source: https://livekit.com/pricing
COST_LIVEKIT_USD_PER_MIN=0.0005
#   OpenAI gpt-4.1-mini (chat-thread auto-translate) — USD per 1000
#   tokens combined (input $0.40/1M + output $1.60/1M). Weighted
#   conservatively at ~$0.001 / 1k.
#   Source: https://openai.com/api/pricing
COST_TEXT_USD_PER_1K_TOKENS=0.001
#   FX rate used to express USD costs in the EUR margin
USD_TO_EUR=0.92

# ── Subscription prices (EUR / month) ─────────────────────────────────
# Used to turn the Plus / Ultra Plus subscriber counts into MRR.
# Numbers must match the Stripe price objects + the in-app paywall
# cards in lib/screens/paywall_screen.dart (the single source of truth).
PRICE_PLUS_EUR=9.99
PRICE_ULTRA_PLUS_EUR=15.99
