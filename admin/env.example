# Swayco Admin — environment.
# Copy this file to `.env.local` (which is git-ignored) and fill it in.

# ── Supabase ──────────────────────────────────────────────────────────
# Same Supabase project as the Swayco app + backend.
#  * URL + anon key are public (used only for the admin sign-in).
#  * The service-role key BYPASSES RLS — it is what reads the locked
#    `analytics_events` table. Server-side only; never expose it.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -- Backend (push notifications) ------------------------------------------
# Base URL of the Swayco backend (backend/server.js, e.g. the Railway URL),
# no trailing slash. The Verifications page calls POST /api/notify with it to
# tell someone their profile was verified or declined. Optional: when unset,
# the decision is still saved and only the push is skipped.
BACKEND_URL=