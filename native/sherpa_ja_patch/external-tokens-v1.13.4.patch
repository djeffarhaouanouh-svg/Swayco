+const SherpaOnnxGeneratedAudio *SherpaOnnxOfflineTtsGenerateFromTokens(
+    const SherpaOnnxOfflineTts *tts, const int64_t *tokens, int32_t n_tokens,
+    const int64_t *tones, int32_t n_tones, int32_t sid, float speed) {
+  if (!tts || !tokens || n_tokens <= 0) {
+    SHERPA_ONNX_LOGE("tts is nullptr or tokens is empty");
+    return nullptr;
+  }
+
+  std::vector<int64_t> token_vec(tokens, tokens + n_tokens);
+  std::vector<int64_t> tone_vec;
+  if (tones && n_tones > 0) {
+    tone_vec.assign(tones, tones + n_tones);
+  }
+
+  sherpa_onnx::GeneratedAudio audio =
+      tts->impl->GenerateFromTokens(token_vec, tone_vec, sid, speed);
+
+  if (audio.samples.empty()) {
+    return nullptr;
+  }
+
+  SherpaOnnxGeneratedAudio *ans = new SherpaOnnxGeneratedAudio;
+  float *samples = new float[audio.samples.size()];
+  std::copy(audio.samples.begin(), audio.samples.end(), samples);
+  ans->samples = samples;
+  ans->n = audio.samples.size();
+  ans->sample_rate = audio.sample_rate;
+  return ans;
+}
