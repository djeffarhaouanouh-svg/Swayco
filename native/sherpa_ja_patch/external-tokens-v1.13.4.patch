+  // Run the VITS model directly from caller-supplied token/tone ids, skipping
+  // the text frontend (see base class). The caller is responsible for producing
+  // ids in the model's symbol set and for add_blank interleaving.
+  GeneratedAudio GenerateFromTokens(const std::vector<int64_t> &tokens,
+                                    const std::vector<int64_t> &tones,
+                                    int64_t sid = 0,
+                                    float speed = 1.0) const override {
+    if (tokens.empty()) {
+      return {};
+    }
+    std::vector<std::vector<int64_t>> batch_tokens = {tokens};
+    std::vector<std::vector<int64_t>> batch_tones;
+    if (!tones.empty()) {
+      batch_tones.push_back(tones);
+    }
+    // silence_scale only affects inter-sentence pauses we don't insert here.
+    return Process(batch_tokens, batch_tones, static_cast<int32_t>(sid), speed,
+                   /*silence_scale=*/1.0);
+  }
