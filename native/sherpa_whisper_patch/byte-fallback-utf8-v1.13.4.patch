+    // Normalise the COMPLETE text once. Applying ApplyInverseTextNormalization
+    // per-token runs RemoveInvalidUtf8Sequences on a single byte-fallback token
+    // (a lone fragment of a multi-byte UTF-8 char is invalid UTF-8 on its own),
+    // dropping the byte before it can be concatenated with the rest of the
+    // character. That corrupts every 3-byte script split across byte tokens
+    // (ja, zh, ko, hi). Concatenating the raw bytes first keeps characters whole.
+    text = ApplyInverseTextNormalization(text);
+    text = ApplyHomophoneReplacer(std::move(text));
+
     r.text = text;
     r.lang = src.lang;
 
